{
  "buildCommand": "node tools/build-sitemap.mjs",
  "outputDirectory": ".",
  "trailingSlash": true,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}